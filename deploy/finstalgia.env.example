# systemd EnvironmentFile syntax: plain key=value, no shell commands or expansions.
FINSTALGIA_JELLYFIN_URL=http://127.0.0.1:8096
FINSTALGIA_SCHEME=https
FINSTALGIA_HOST=127.0.0.1
FINSTALGIA_PORT=18443
FINSTALGIA_CONFIG_DIR=/var/lib/finstalgia
FINSTALGIA_IDLE_SECONDS=1800
FINSTALGIA_MAX_SECONDS=14400
