# Copy this to .env in the project root for Docker Compose deployment.
# On Docker Desktop, host.docker.internal reaches Jellyfin on the host.
# A Jellyfin container on the same Docker network can use its service name instead.
FINSTALGIA_JELLYFIN_URL=http://host.docker.internal:8096
FINSTALGIA_SCHEME=https
FINSTALGIA_PORT=18443
# Set to your LAN IP to allow iPad access; loopback is the safe default.
FINSTALGIA_BIND_IP=127.0.0.1
FINSTALGIA_IDLE_SECONDS=1800
FINSTALGIA_MAX_SECONDS=14400
