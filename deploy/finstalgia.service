[Unit]
Description=Finstalgia Jellyfin bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=finstalgia
Group=finstalgia
WorkingDirectory=/opt/finstalgia
EnvironmentFile=/etc/finstalgia/finstalgia.env
ExecStart=/opt/finstalgia/.venv/bin/python -m finstalgia serve --no-env-file
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
StateDirectory=finstalgia
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
