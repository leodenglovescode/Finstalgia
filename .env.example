# Copy to .env and edit. Automatically read from the current working directory.
# Precedence: CLI flags > process environment > this file > built-in defaults.
# No shell execution or ${VARIABLE} expansion by Finstalgia.
FINSTALGIA_JELLYFIN_URL=http://127.0.0.1:8096
# Use https after running cert-init. Leave PORT unset to use 18095 / 18443 automatically.
FINSTALGIA_SCHEME=http
FINSTALGIA_HOST=127.0.0.1
# FINSTALGIA_PORT=18095
FINSTALGIA_CONFIG_DIR=~/.config/finstalgia
FINSTALGIA_IDLE_SECONDS=1800
FINSTALGIA_MAX_SECONDS=14400
# Optional PEM CA bundle for the upstream Jellyfin HTTPS connection:
# FINSTALGIA_UPSTREAM_CA=/protected/path/jellyfin-ca.pem
# One worker only. No Jellyfin password or token belongs here.
# Docker Compose only: published host interface (explicit LAN opt-in).
# FINSTALGIA_BIND_IP=127.0.0.1
